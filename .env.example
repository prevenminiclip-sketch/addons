# DuckDNS Full Domain (e.g. yoursubdomain.duckdns.org)
DUCKDNS_DOMAIN=yoursubdomain.duckdns.org

# DuckDNS API Token from https://www.duckdns.org
DUCKDNS_TOKEN=your_duckdns_token_here

# Secret Access Token (Optional: Protects addon from unauthorized users & crawlers)
# If set, your Stremio manifest URL becomes: https://yoursubdomain.duckdns.org/YOUR_SECRET_KEY/manifest.json
ACCESS_KEY=your_secret_token_here

# Optional port overrides
PORT=7000
CADDY_HTTPS_PORT=443
