# =============================================================================
# Option 1: Zero-Config Hostname (Recommended for OCI / VPS with Static IP)
# Format: <your-static-ip>.sslip.io (Caddy will auto-generate a Let's Encrypt certificate)
# =============================================================================
DOMAIN=129.151.77.20.sslip.io

# =============================================================================
# Option 2: DuckDNS (If preferred over sslip.io)
# =============================================================================
# DUCKDNS_DOMAIN=yoursubdomain.duckdns.org
# DUCKDNS_TOKEN=your_duckdns_token_here

# =============================================================================
# Secret Access Token (Protects addon from unauthorized users & crawlers)
# Manifest URL: https://<DOMAIN>/<ACCESS_KEY>/manifest.json
# =============================================================================
ACCESS_KEY=your_secret_token_here

# Optional port overrides
PORT=7000
CADDY_HTTPS_PORT=443
